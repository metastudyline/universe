#!/usr/bin/env bash
# ==============================================================================
#  ✦ StudyLine Universal Native CLI Direct Launcher
# ==============================================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
BIN="$DIR/tools/target/release/studyline"

if [ ! -f "$BIN" ]; then
    echo "[INFO] 🔨 正在首次编译 StudyLine Native CLI..."
    cargo build --release --bin studyline --manifest-path "$DIR/tools/Cargo.toml"
fi

exec "$BIN" "$@"
