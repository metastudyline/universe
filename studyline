#!/usr/bin/env bash
# ==============================================================================
#  ✦ StudyLine Universal CLI — 知识图引擎与开发工作流统一命令中枢
# ==============================================================================

set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
COMPILER_BIN="$DIR/tools/target/release/studyline-compiler"
DAEMON_BIN="$DIR/tools/target/release/studyline-daemon"
DOMAINS_DIR="$DIR/domains"
SCHEMAS_DIR="$DIR/schemas"

# Colors
BOLD="\033[1m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
YELLOW="\033[1;33m"
CYAN="\033[0;36m"
RED="\033[0;31m"
RESET="\033[0m"

print_banner() {
    echo -e "${BOLD}${CYAN}"
    echo "  ╔═══════════════════════════════════════════════════════════════════╗"
    echo "  ║            ✦ StudyLine Universal Command Hub (CLI)                ║"
    echo "  ║        High-Performance Rust Graph Engine & Knowledge Web         ║"
    echo "  ╚═══════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

ensure_compiled() {
    if [ ! -f "$COMPILER_BIN" ] || [ ! -f "$DAEMON_BIN" ]; then
        echo -e "${YELLOW}[INFO] 🔨 正在首次编译 Rust 核心工具链...${RESET}"
        cd "$DIR/tools"
        cargo build --release
        cd "$DIR"
        echo -e "${GREEN}[SUCCESS] ✓ Rust 工具链编译完成。${RESET}\n"
    fi
}

cmd_dev() {
    print_banner
    ensure_compiled
    echo -e "${BOLD}${BLUE}==> 启动本地开发全栈服务 (Rust Daemon + Web 星云画布)...${RESET}"
    bash "$DIR/run_web.sh"
}

cmd_check() {
    print_banner
    echo -e "${BOLD}${BLUE}==> 执行本地秒级 Knowledge CI 验证...${RESET}"
    bash "$DIR/tools/scripts/local_ci.sh"
}

cmd_build() {
    print_banner
    echo -e "${BOLD}${BLUE}==> 正在全量编译 Rust 图核心、编译器与守护进程...${RESET}"
    cd "$DIR/tools"
    cargo build --release
    echo -e "${GREEN}[SUCCESS] ✓ Rust 二进制编译成功: target/release/${RESET}"
    
    echo -e "\n${BOLD}${BLUE}==> 正在编译前端渲染器 TypeScript 库...${RESET}"
    cd "$DIR/packages/studyline-renderer"
    npx tsc
    echo -e "${GREEN}[SUCCESS] ✓ 前端渲染器构建成功: dist/${RESET}"
}

cmd_path() {
    TARGET="$1"
    if [ -z "$TARGET" ]; then
        echo -e "${RED}[ERROR] 请指定目标节点 ID，例如: ./studyline path E82${RESET}"
        exit 1
    fi
    ensure_compiled
    echo -e "${BOLD}${BLUE}==> 正在求解到达目标节点 [${TARGET}] 的最短必修学线...${RESET}\n"
    "$COMPILER_BIN" path --target "$TARGET"
}

cmd_diff() {
    BASE="$1"
    HEAD="$2"
    if [ -z "$BASE" ] || [ -z "$HEAD" ]; then
        echo -e "${RED}[ERROR] 请指定对比的 Base 与 Head 分支/Commit，例如: ./studyline diff main HEAD${RESET}"
        exit 1
    fi
    ensure_compiled
    echo -e "${BOLD}${BLUE}==> 正在计算从 ${BASE} 到 ${HEAD} 变更节点的受影响子图 (Blast Radius)...${RESET}\n"
    "$COMPILER_BIN" diff --base "$BASE" --head "$HEAD"
}

cmd_status() {
    print_banner
    ensure_compiled
    echo -e "${BOLD}📊 知识库全景资产统计:${RESET}"
    
    TOTAL_MANIFESTS=$(find "$DOMAINS_DIR" -name "manifest.yml" -o -name "manifest.yaml" | wc -l | tr -d ' ')
    TOTAL_LECTURES=$(find "$DOMAINS_DIR" -name "index.md" | wc -l | tr -d ' ')
    TOTAL_SPECS=$(find "$DIR/specs" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
    
    echo -e "  • 知识节点 (Manifests):   ${GREEN}${TOTAL_MANIFESTS}${RESET} 个"
    echo -e "  • 原典深度讲义 (Lectures):  ${GREEN}${TOTAL_LECTURES}${RESET} 篇"
    echo -e "  • 特性规格工程 (Specs):    ${GREEN}${TOTAL_SPECS}${RESET} 个"
    echo -e "  • Rust 编译器:           ${CYAN}${COMPILER_BIN}${RESET}"
    echo -e "  • Rust 守护进程:         ${CYAN}${DAEMON_BIN}${RESET}"
    echo -e "  • Web 渲染包:            ${CYAN}${DIR}/packages/studyline-renderer${RESET}"
    echo ""
}

cmd_help() {
    print_banner
    echo -e "${BOLD}使用方式:${RESET}"
    echo "  ./studyline <command> [arguments]"
    echo ""
    echo -e "${BOLD}常用命令 (Commands):${RESET}"
    echo -e "  ${GREEN}dev${RESET} | ${GREEN}start${RESET}             一键启动本地 Rust 守护进程 (:3001) + Web 星云画布 (:3000)"
    echo -e "  ${GREEN}check${RESET} | ${GREEN}ci${RESET}            运行本地秒级 CI 检验 (Draft-07 Schema 校验 + 全局 DAG 无环检查)"
    echo -e "  ${GREEN}build${RESET}                 全量编译 Rust 二进制 (Compiler & Daemon) 与前端 TypeScript 产物"
    echo -e "  ${GREEN}status${RESET}                查看知识库资产、节点规模与工具链编译状态"
    echo -e "  ${GREEN}path <NODE_ID>${RESET}        在终端即时求解到达某一节点的最短学线拓扑路径 (如 ./studyline path E66)"
    echo -e "  ${GREEN}diff <BASE> <HEAD>${RESET}    分析两分支间知识变更引起的下游受影响子图 (Blast Radius)"
    echo -e "  ${GREEN}help${RESET}                  显示本帮助手册"
    echo ""
}

# Main Dispatcher
case "$1" in
    dev|start)
        cmd_dev
        ;;
    check|ci|test)
        cmd_check
        ;;
    build)
        cmd_build
        ;;
    status)
        cmd_status
        ;;
    path)
        cmd_path "$2"
        ;;
    diff)
        cmd_diff "$2" "$3"
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        echo -e "${RED}[ERROR] 未知命令: $1${RESET}"
        echo "运行 ./studyline help 查看可用指令。"
        exit 1
        ;;
esac
