{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studyline.org/schemas/v1/hub-registry.schema.json",
  "title": "StudyLineHubRegistrySchema",
  "description": "Schema for StudyLine Global Knowledge Hub registry (registry.yml), tracking federated domain repositories",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "last_updated", "domain_repositories"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the registry format"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the latest global registry compilation"
    },
    "domain_repositories": {
      "type": "array",
      "minItems": 1,
      "description": "List of federated domain repositories registered in the global hub",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "repository_url",
          "target_branch",
          "pinned_release_tag",
          "pinned_commit_sha",
          "domain_category",
          "maintainer_team",
          "exported_node_prefix",
          "node_count",
          "status"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique namespace prefix for this repository (e.g. 'philosophy', 'cs-systems')"
          },
          "repository_url": {
            "type": "string",
            "format": "uri",
            "description": "Public Git clone URL (e.g. https://github.com/studyline/domain-philosophy.git)"
          },
          "target_branch": {
            "type": "string",
            "minLength": 1,
            "description": "Main tracking branch (e.g. 'main')"
          },
          "pinned_release_tag": {
            "type": "string",
            "minLength": 1,
            "description": "Latest stable release tag (e.g. 'v1.2.0')"
          },
          "pinned_commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "description": "Full 40-character Git commit hash corresponding to the release"
          },
          "domain_category": {
            "type": "string",
            "enum": [
              "philosophy",
              "mathematics",
              "computer_science",
              "natural_science",
              "life_hacker",
              "social_science"
            ],
            "description": "High-level domain category"
          },
          "maintainer_team": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^@[a-zA-Z0-9_-]+$",
              "description": "GitHub team or user handle"
            }
          },
          "exported_node_prefix": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$",
            "description": "Node URI prefix managed by this repository (e.g. 'philosophy.ancient-greek')"
          },
          "node_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Total number of verified knowledge nodes in this sub-repository"
          },
          "status": {
            "type": "string",
            "enum": ["active", "deprecated", "quarantined"],
            "description": "Federation health status"
          }
        }
      }
    }
  }
}
