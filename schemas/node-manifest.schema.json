{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyLineGenericNodeManifest",
  "description": "StudyLine 全域知识节点通用元数据与 DAG 拓扑契约",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "title",
    "domain",
    "stage",
    "estimated_minutes",
    "strict_prerequisites"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "node_id": {
      "type": "string",
      "description": "节点唯一标识符，如 R01, A04, E07, M01"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "domain": {
      "type": "string",
      "enum": ["rust", "philosophy", "meta_learning", "life_hacker"]
    },
    "stage": {
      "type": "string"
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "summary": {
      "type": "string"
    },
    "strict_prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "soft_prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "learning_objectives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exit_criteria": {
      "type": "object",
      "properties": {
        "quiz_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "prompt", "options", "correct_answer", "explanation"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["single_choice", "multiple_choice", "sort_syllogism"] },
              "prompt": { "type": "string" },
              "options": {
                "type": "array",
                "items": { "type": "string" }
              },
              "correct_answer": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              },
              "explanation": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "practical_challenge": {
          "type": "object",
          "required": ["prompt", "verification_command"],
          "properties": {
            "prompt": { "type": "string" },
            "verification_command": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
