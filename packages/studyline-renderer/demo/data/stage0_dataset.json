  "terms": [
    {
      "id": "dike",
      "greek": "δίκη",
      "translit": "dikē",
      "ipa": "/dí.kɛː/",
      "literal": "划界、判决、诉讼程序",
      "cn": "正义、习俗法则",
      "en": "justice, customary right",
      "note": "赫西俄德对抗 hybris 的核心武器，阿那克西曼德'相互补偿其不义'的母本"
    },
    {
      "id": "hybris",
      "greek": "ὕβρις",
      "translit": "hybris",
      "ipa": "/hý.bris/",
      "literal": "狂暴、越界、傲慢放肆",
      "cn": "狂妄、越界",
      "en": "wanton violence, insolence",
      "note": "破坏尺度招致毁灭的根本原因"
    },
    {
      "id": "time",
      "greek": "τιμή",
      "translit": "timē",
      "ipa": "/tiː.mɛ̌ː/",
      "literal": "荣誉、社会份额、价值评估",
      "cn": "荣誉、份额",
      "en": "honor, rightful share",
      "note": "《伊利亚特》全书冲突的枢纽，公共分配正义的原型"
    },
    {
      "id": "chaos",
      "greek": "Χάος",
      "translit": "Chaos",
      "ipa": "/kʰá.os/",
      "literal": "裂口、张开的深渊",
      "cn": "卡俄斯、混沌",
      "en": "chasm, void, abyss",
      "note": "在《神谱》116行最初生成，不是混乱，而是裂开的空间"
    },
    {
      "id": "arche",
      "greek": "ἀρχή",
      "translit": "archē",
      "ipa": "/ar.kʰɛ̌ː/",
      "literal": "开端、本原、支配统治",
      "cn": "本原、始基",
      "en": "beginning, first principle",
      "note": "通向前苏格拉底自然哲学的核心概念"
    },
